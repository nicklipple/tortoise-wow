# Copy this file to the deployment runner as:
#   /etc/tortoise-wow/dev-1.env
#   /etc/tortoise-wow/dev-2.env
#
# Change the slot-specific values in each copy. Do not commit the populated
# files. The deploy jobs source this file and pass it to Docker Compose.
#
# COMPOSE_FILE should point to a trusted server-side copy, not a Compose file
# from the branch being deployed. If the runner uses the Docker executor, make
# this directory and the paths below available inside the runner container.

COMPOSE_FILE=/srv/tortoise-wow/docker-compose.yml
COMPOSE_PROJECT_NAME=tortoise-wow-dev-1
DEPLOY_LOCK_DIR=/srv/tortoise-wow/locks

# Host paths. DATA_PATH may be shared by both slots because the container mount
# is read-only. Keep database, marker, config, and web files per environment.
DATA_PATH=/srv/tortoise-wow/client-data
TURTLE_CONFIG_PATH=/srv/tortoise-wow/dev-1/config
DB_DATA_PATH=/srv/tortoise-wow/dev-1/db
INIT_MARKER_PATH=/srv/tortoise-wow/dev-1/init-marker
WEB_CONFIG_PATH=/srv/tortoise-wow/dev-1/mangos-web/config.json
MARIADB_CONFIG_PATH=/srv/tortoise-wow/mariadb.cnf

# Host port bindings. DB_PORT is host-side only; containers use db:3306.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8485
DB_BIND_IP=127.0.0.1
DB_PORT=3307
GAME_BIND_IP=0.0.0.0
REALM_PORT=3725
WORLD_PORT=8091

# Optional image overrides. TURTLE_IMAGE is supplied by the GitLab job from
# the exact CI_COMMIT_SHA and should not be set here.
MANGOS_WEB_IMAGE=registry.gitlab.com/cavillis/mangos-web:latest
MARIADB_IMAGE=mariadb:11.8@sha256:d9f7eb2637296652f24b484afd5d246f759f49f5babcadc6a9e344c9acb75fbf

# Database and realm settings. Quote values if they contain shell metacharacters.
DB_ROOT_PASSWORD=CHANGE_ME
DB_USER=mangos
DB_PASSWORD=CHANGE_ME
DB_LOGIN=tw_logon
DB_WORLD=tw_world
DB_CHAR=tw_char
DB_LOGS=tw_logs
REALM_NAME=TortoiseWoW-dev-1
REALM_ADDRESS=CHANGE_ME
REALM_ID=1

# Server feature settings.
LOG_SQL=0
DATABASE_AUTOUPDATE_ENABLED=1
LFT_BOTFILL_ENABLE=1
SOLO_DUNGEON_REPOP_ALIVE_ENABLE=1
LEECH_ENABLE=1
AI_PLAYERBOT_ENABLED=1
AI_MIN_RANDOM_BOTS=10
AI_MAX_RANDOM_BOTS=10
